    {
      "id": "the-hill",
      "year": "52 BC",
      "sortYear": -52,
      "headline": "The hill",
      "body": "Vercingetorix has done what no Gaul managed before: united tribes that spent generations raiding each other, then refused to fight Rome in the open. He burns his own countryside instead, starving the legions out of a land they cannot forage. When a cavalry engagement goes wrong he withdraws to Alesia, a hill fort of the Mandubii, with eighty thousand men. He expects to be besieged. He has already sent riders to every tribe in Gaul.",
      "visibleLayers": [
        "sky",
        "far_ridge",
        "hillfort",
        "mid_ground",
        "foreground"
      ],
      "camera": {
        "x": 0.12,
